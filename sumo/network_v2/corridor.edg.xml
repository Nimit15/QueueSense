    <edge id="in_north_1" from="NS" to="J1" priority="1" numLanes="1" speed="11.1"/>
    <edge id="in_north_2" from="NS" to="J2" priority="1" numLanes="1" speed="11.1"/>
    <edge id="in_north_3" from="NS" to="J3" priority="1" numLanes="1" speed="11.1"/>
    <edge id="out_north_1" from="J1" to="SS" priority="1" numLanes="1" speed="11.1"/>
    <edge id="out_north_2" from="J2" to="SS" priority="1" numLanes="1" speed="11.1"/>
    <edge id="out_north_3" from="J3" to="SS" priority="1" numLanes="1" speed="11.1"/>
</edges>