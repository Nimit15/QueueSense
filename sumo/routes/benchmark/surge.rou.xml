<routes>
    <!-- Surge / peak period: sudden 2.5x traffic surge on one approach at t=600s -->
    <vType id="car" vClass="passenger" speedDev="0.1" sigma="0.5" />
    <route id="west_east" edges="in_west art_east out_east"/>
    <route id="east_west" edges="in_east art_east out_east"/>
    <route id="north_south" edges="in_north out_north"/>

    <!-- Base demand -->
    <flow id="flow_west_east" type="car" route="west_east" begin="0" end="3600" number="600" departSpeed="max" departLane="best"/>
    <flow id="flow_east_west" type="car" route="east_west" begin="0" end="3600" number="300" departSpeed="max" departLane="best"/>
    <flow id="flow_north_south" type="car" route="north_south" begin="0" end="600" number="300" departSpeed="max" departLane="best"/>

    <!-- Surge: 2.5x increase on north-south at t=600s -->
    <flow id="flow_north_south_surge" type="car" route="north_south" begin="600" end="3600" number="750" departSpeed="max" departLane="best"/>
</routes>
